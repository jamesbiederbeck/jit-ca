# Copy to .env and uncomment what you need. Compose reads .env automatically; .env is git-ignored.
# Every line below shows the built-in default (compose.yaml fallbacks); values are examples.
# Changing any JITCA_* value regenerates config/config.toml on the next start
# (the previous one is kept as config.toml.bak).

# --- Where the container listens on the host -------------------------------------------------------
# Default: loopback and unprivileged ports. To serve devices on your network set JITCA_BIND_ADDRESS to
# this host's LAN address and use the real ports (a resolver already on port 53 there will conflict).
#JITCA_BIND_ADDRESS=127.0.0.1
#JITCA_DNS_PORT=15353
#JITCA_TLS_PORT=18443

# Run as this host uid/gid so the ./config and ./state bind mounts stay writable.
#LOCAL_UID=1000
#LOCAL_GID=1000

# --- DNS -------------------------------------------------------------------------------------------
# Address DNS answers point clients at: normally the same address clients reach JITCA_BIND_ADDRESS on.
#JITCA_REDIRECT_IPV4=127.0.0.1

# Comma or space separated CIDRs allowed to use DNS and TLS. Everything else is dropped and logged.
# Example for a LAN: JITCA_ALLOWED_CLIENTS=192.0.2.0/24,198.51.100.0/24
#JITCA_ALLOWED_CLIENTS=127.0.0.1/32

# Answer every A query with JITCA_REDIRECT_IPV4 instead of REFUSED for unknown names.
#JITCA_DNS_ANSWER_ALL=true

# --- Endpoints ---------------------------------------------------------------------------------------
# Serve and log hostnames that are not explicit endpoints (on-demand certificates), and the cap on how
# many distinct such names get a certificate per run.
#JITCA_DEFAULT_ENDPOINT=true
#JITCA_DEFAULT_MAX_HOSTNAMES=200

# Explicit endpoints: comma or space separated hostnames (empty: none, everything uses the default endpoint).
#JITCA_ENDPOINTS=

# --- Certificates ------------------------------------------------------------------------------------
# Substring of a CA subject. Empty: with several CAs in the CA volume the first CA by filename with a
# unique subject is used (the choice is logged at startup).
#JITCA_DEFAULT_ISSUER=

# Leaf certificate key type: p256 or rsa2048.
#JITCA_LEAF_KEY=p256

# --- Logging and capture -----------------------------------------------------------------------------
# Write raw, unredacted request/response bodies to state/captures/ (treat it as sensitive).
#JITCA_CAPTURE_BODIES=true

# Also print every event as a JSON line to stdout (docker compose logs).
#JITCA_LOG_STDOUT=true

# Redact saved JSON bodies and, by default, event headers/query/JSON previews.
#JITCA_CAPTURE_REDACT=false
# Override event redaction independently; unset inherits enabled capture settings.
#JITCA_LOG_REDACT=false
